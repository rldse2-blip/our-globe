
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OUR GLOBE — One Globe. Millions of Owners.</title>
<style>
*{box-sizing:border-box}
body{
margin:0;
background:#05080d;
color:#fff;
font-family:Arial, sans-serif;
text-align:center;
}
header{
padding:28px 20px;
display:flex;
justify-content:space-between;
align-items:center;
max-width:1200px;
margin:auto;
}
.logo{font-size:22px;font-weight:bold;letter-spacing:4px}
nav{color:#aaa;font-size:13px;letter-spacing:1px}
.hero{padding:45px 20px 20px}
h1{
font-size:clamp(36px,7vw,72px);
letter-spacing:-2px;
margin:10px 0;
}
.subtitle{color:#9ca8b8;letter-spacing:3px;font-size:13px}
.globe-wrap{
width:min(90vw,650px);
margin:35px auto;
position:relative;
}
canvas{
width:100%;
height:auto;
display:block;
cursor:grab;
}
button{
background:#fff;
color:#05080d;
border:0;
padding:17px 38px;
font-size:14px;
font-weight:bold;
letter-spacing:2px;
cursor:pointer;
border-radius:3px;
}
button:hover{background:#b9d5ca}
.stats{
display:flex;
justify-content:center;
gap:55px;
flex-wrap:wrap;
padding:45px 15px;
}
.stat strong{display:block;font-size:28px}
.stat span{color:#8793a3;font-size:11px;letter-spacing:2px}
footer{
color:#687383;
padding:35px 15px;
font-size:12px;
}
</style>
</head>
<body>

<header>
<div class="logo">OUR GLOBE</div>
<nav>ONE PLANET. ONE COMMUNITY.</nav>
</header>

<section class="hero">
<p class="subtitle">A WORLD OWNED BY EVERYONE</p>
<h1>ONE GLOBE.<br>MILLIONS OF OWNERS.</h1>
<p class="subtitle">OWN YOUR PIXEL. COLOR OUR WORLD.</p>
</section>

<div class="globe-wrap">
<canvas id="globe" width="800" height="800"></canvas>
</div>

<button onclick="document.getElementById('buy').scrollIntoView({behavior:'smooth'})">
BUY PIXELS
</button>

<section class="stats">
<div class="stat">
<strong>10,000,000</strong>
<span>TOTAL PIXELS</span>
</div>
<div class="stat">
<strong>€0.10</strong>
<span>PRICE PER PIXEL</span>
</div>
<div class="stat">
<strong id="available">10,000,000</strong>
<span>AVAILABLE PIXELS</span>
</div>
</section>

<section id="buy" style="padding:55px 20px">
<h2>YOUR PIXEL. YOUR COLOR.</h2>
<p style="color:#9ca8b8">Become part of a world created by millions.</p>
<button onclick="alert('Pixel marketplace coming soon!')">EXPLORE PIXELS</button>
</section>

<footer>© 2026 OUR GLOBE — ONE WORLD, MILLIONS OF OWNERS.</footer>

<script>
const canvas=document.getElementById("globe");
const ctx=canvas.getContext("2d");
let rotation=0;
let dragging=false;
let lastX=0;

function draw(){
const w=canvas.width;
const h=canvas.height;
const cx=w/2,cy=h/2,r=310;
ctx.clearRect(0,0,w,h);

ctx.beginPath();
ctx.arc(cx,cy,r,0,Math.PI*2);
const ocean=ctx.createRadialGradient(cx-100,cy-120,20,cx,cy,r);
ocean.addColorStop(0,"#164b68");
ocean.addColorStop(1,"#030b18");
ctx.fillStyle=ocean;
ctx.fill();

ctx.save();
ctx.beginPath();
ctx.arc(cx,cy,r,0,Math.PI*2);
ctx.clip();

const continents=[
[0.05,0.25,0.20,0.24],
[0.18,0.48,0.13,0.28],
[0.43,0.22,0.28,0.22],
[0.51,0.48,0.19,0.30],
[0.75,0.30,0.18,0.20],
[0.78,0.55,0.13,0.16]
];

for(let i=0;i<continents.length;i++){
const [x,y,ww,hh]=continents[i];
ctx.fillStyle="#397c60";
ctx.fillRect(
cx-r+x*2*r,
cy-r+y*2*r,
ww*2*r,
hh*2*r
);
}

for(let i=0;i<26000;i++){
const lat=Math.random()*Math.PI-Math.PI/2;
const lon=Math.random()*Math.PI*2+rotation;
const x=cx+r*Math.cos(lat)*Math.sin(lon);
const y=cy-r*Math.sin(lat);
const z=Math.cos(lat)*Math.cos(lon);
if(z>0){
ctx.fillStyle=Math.random()>.5?"#b7d5bd":"#568d70";
ctx.fillRect(x,y,3,3);
}
}
ctx.restore();

ctx.beginPath();
ctx.arc(cx,cy,r,0,Math.PI*2);
ctx.strokeStyle="#4d91a2";
ctx.lineWidth=2;
ctx.stroke();
}

canvas.addEventListener("pointerdown",e=>{
dragging=true;
lastX=e.clientX;
canvas.setPointerCapture(e.pointerId);
});
canvas.addEventListener("pointerup",()=>dragging=false);
canvas.addEventListener("pointermove",e=>{
if(!dragging)return;
rotation+=(e.clientX-lastX)*0.008;
lastX=e.clientX;
draw();
});
setInterval(()=>{
if(!dragging){
rotation+=0.003;
draw();
}
},40);
draw();
</script>

</body>
</html>
